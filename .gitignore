# Repositório da operação: só código, skills, regras e documentos.
# Lista branca: tudo fica de fora, menos as pastas liberadas abaixo.
/*
!/.gitignore
!/CLAUDE.md
!/README.md
!/.mcp.json
!/07-referencias-criativos/
!/.claude/
!/contexto/
!/kit-edicao-criativos/
!/ferramentas/
!/painel/
!/02-relatorios/
!/03-dashboards/
!/05-pdfs-didaticos/
!/06-infograficos/
!/_portatil/

# Fora sempre: chaves e configurações locais
.env
.env.*
*.key
*.pem
**/credentials*
**/token*.json
.claude/settings.local.json
**/*.backup*

# Fora sempre: mídia, modelos, binários e pacotes (vão pelo Drive ou baixam de novo)
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.psd
*.zip
*.7z
*.rar
*.exe
*.dll
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
*.npy
*.pkl
*.idx

# Fora sempre: ambientes e caches
__pycache__/
*.pyc
venv/
.venv/
_vg/
node_modules/
**/output/
**/logs/
**/tmp/
painel/img/
painel/status.json
painel/atividade.jsonl
ferramentas/bin/
ferramentas/_pacotes/
