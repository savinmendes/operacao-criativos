  "dur": 6.252,
  "orig_ini": 2065.47,
  "orig_fim": 2071.404,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "und dann in allem anderen. Und das verändert alles. Was Ihnen hier angeboten wird, steht nicht jedem offen.",
  "id": "L235",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 61242,
  "N": 187,
  "env_orig_fim": 2071.404,
  "crop": null,
  "envN": 187
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
