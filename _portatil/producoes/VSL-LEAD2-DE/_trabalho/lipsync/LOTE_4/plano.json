  "orig_ini": 2025.634,
  "orig_fim": 2034.206,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "geistliche Richtung, einen gefestigten Glauben, inneren Frieden, Disziplin, Fokus, Stärke, Bewusstsein –",
  "id": "L230",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 59983,
  "N": 271,
  "env_orig_fim": 2034.206,
  "crop": null,
  "envN": 271
 },
 {
  "falante": "padre",
