  "dur": 6.267,
  "orig_ini": 2162.595,
  "orig_fim": 2168.81,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "Hören Sie gut zu, denn vielleicht ist eine dieser Fragen genau die, die Ihnen gerade durch den Kopf geht.",
  "id": "L246",
