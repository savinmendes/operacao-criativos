  "dur": 6.684,
  "orig_ini": 2155.967,
  "orig_fim": 2162.595,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "Ihnen acht wichtige Fragen beantworten, damit Sie Ihre Entscheidung in Ruhe und ohne jeden Zweifel treffen können.",
  "id": "L245",
  "lote": 4,
  "corte_dentro_de_palavra": [],
