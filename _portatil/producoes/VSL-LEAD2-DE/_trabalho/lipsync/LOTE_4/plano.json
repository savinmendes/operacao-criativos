  "novo_fim": 2104.256,
  "dur": 9.415,
  "orig_ini": 2116.201,
  "orig_fim": 2125.137,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "etwa bei Amazon oder bei Google-Diensten – Ihre Daten sind geschützt, und der Zugang erfolgt sofort. Darum können Sie beruhigt weitergehen.",
