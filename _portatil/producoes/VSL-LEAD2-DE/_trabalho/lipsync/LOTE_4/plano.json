  "dur": 4.549,
  "orig_ini": 2050.635,
  "orig_fim": 2054.952,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Und dies ist einer dieser Momente. Sie müssen jetzt nicht alles verstehen.",
  "id": "L233",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 60773,
  "N": 136,
  "env_orig_fim": 2054.952,
  "crop": null,
  "envN": 136
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
  "novo_ini": 2030.309,
  "novo_fim": 2041.39,
  "dur": 11.081,
  "orig_ini": 2054.952,
  "orig_fim": 2065.47,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Sie dürfen ihn nur nicht verstreichen lassen. Denn wenn wir solche Rufe überhören, bleibt alles, wie es ist. Doch wenn wir antworten, beginnt sich etwas zu bewegen – zuerst in uns",
  "id": "L234",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 60909,
  "N": 333,
  "env_orig_fim": 2065.47,
  "crop": null,
  "envN": 333
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
