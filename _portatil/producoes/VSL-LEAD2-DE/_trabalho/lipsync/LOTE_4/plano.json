  "orig_ini": 2263.332,
  "orig_fim": 2270.197,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "Nachdem Sie Ihre Anmeldung bestätigt haben, erhalten Sie die Anleitung für den Zugang zu den Inhalten direkt per E-Mail.",
  "id": "L257",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 67341,
  "N": 208,
  "env_orig_fim": 2270.197,
  "crop": null,
  "envN": 208
 },
 {
  "falante": "padre",
