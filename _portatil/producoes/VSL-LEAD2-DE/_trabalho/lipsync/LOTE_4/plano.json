  "orig_ini": 2288.119,
  "orig_fim": 2292.732,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "um in Ruhe zu entscheiden, ob dieser Weg für Sie Sinn ergibt.",
  "id": "L260",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 68091,
  "N": 139,
  "env_orig_fim": 2292.732,
  "crop": null,
  "envN": 139
 },
 {
  "falante": "padre",
  "cena": "padre_close",
  "novo_ini": 2274.35,
  "novo_fim": 2281.457,
  "dur": 7.107,
  "orig_ini": 2292.732,
  "orig_fim": 2299.779,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "Wenn Sie innerhalb der Garantiezeit merken, dass Sie nicht weitermachen möchten, können Sie sich an unser Support-Team wenden",
  "id": "L261",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 68230,
  "N": 214,
  "env_orig_fim": 2299.779,
  "crop": null,
  "envN": 214
 },
 {
  "falante": "padre",
  "cena": "padre_close",
  "novo_ini": 2281.457,
