  "orig_ini": 2034.207,
  "orig_fim": 2044.433,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "und als Folge bessere Entscheidungen, bessere Ergebnisse, ein besseres Leben. Und jetzt liegt dieser Moment vor Ihnen – nicht als etwas Zufälliges, sondern als Entscheidung.",
  "id": "L231",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 60254,
  "N": 323,
  "env_orig_fim": 2044.433,
  "crop": null,
  "envN": 323
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
  "novo_ini": 2019.226,
  "novo_fim": 2025.76,
  "dur": 6.534,
  "orig_ini": 2044.433,
  "orig_fim": 2050.635,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Denn es gibt Momente im Leben, in denen alles stillzustehen scheint und sich trotzdem etwas öffnet.",
  "id": "L232",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 60577,
  "N": 196,
  "env_orig_fim": 2050.635,
  "crop": null,
  "envN": 196
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
