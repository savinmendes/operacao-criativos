  "dur": 9.801,
  "orig_ini": 2098.866,
  "orig_fim": 2108.168,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "um zuzuhören, anzuwenden und klar zu spüren, ob dieser Weg für Sie ist. Und wenn nicht, lassen Sie ihn einfach hinter sich – ohne Hürden.",
  "id": "L239",
  "lote": 4,
  "corte_dentro_de_palavra": [],
