  "dur": 10.675,
  "orig_ini": 2270.197,
  "orig_fim": 2280.783,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "„Und wenn ich nach dem Einstieg merke, dass dieser Weg nichts für mich ist?“ Sie können ganz beruhigt beginnen, denn Ihre Entscheidung ist durch eine 90-Tage-Garantie geschützt.",
  "id": "L258",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 67549,
  "N": 320,
  "env_orig_fim": 2280.783,
  "crop": null,
  "envN": 320
 },
 {
  "falante": "padre",
