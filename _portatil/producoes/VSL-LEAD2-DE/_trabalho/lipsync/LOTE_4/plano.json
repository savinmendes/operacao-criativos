  "dur": 6.239,
  "orig_ini": 2131.578,
  "orig_fim": 2137.5,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Schieben Sie es also nicht auf. Gehen Sie diesen Schritt: Klicken Sie auf den Button unter diesem Video, sichern Sie",
