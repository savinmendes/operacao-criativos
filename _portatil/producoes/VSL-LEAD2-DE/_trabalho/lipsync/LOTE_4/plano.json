  "q0": 62845,
  "N": 283,
  "env_orig_fim": 2125.137,
  "crop": null,
  "envN": 283
 },
 {
  "falante": "padre",
  "cena": "padre_medio",
  "novo_ini": 2104.256,
  "novo_fim": 2111.042,
  "dur": 6.786,
  "orig_ini": 2125.137,
  "orig_fim": 2131.578,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Es geht nicht um das, was Sie bisher gesehen haben, sondern darum, was Sie jetzt daraus machen.",
  "id": "L242",
  "lote": 4,
  "corte_dentro_de_palavra": [],
