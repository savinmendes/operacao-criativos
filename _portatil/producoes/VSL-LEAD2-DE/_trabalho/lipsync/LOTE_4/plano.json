  "orig_ini": 2108.168,
  "orig_fim": 2116.201,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Außerdem ist der ganze Ablauf geschützt: Es ist dieselbe digitale Umgebung, die Sie nutzen, wenn Sie bei bekannten Plattformen einkaufen,",
  "id": "L240",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 62591,
  "N": 254,
  "env_orig_fim": 2116.201,
  "crop": null,
  "envN": 254
 },
 {
