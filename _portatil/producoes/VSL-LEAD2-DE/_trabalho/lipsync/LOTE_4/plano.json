  "novo_ini": 2262.301,
  "novo_fim": 2269.698,
  "dur": 7.398,
  "orig_ini": 2280.783,
  "orig_fim": 2288.119,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "In dieser Zeit können Sie hineinschauen, die Inhalte kennenlernen, das Gebet hören und den Anleitungen folgen –",
  "id": "L259",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 67869,
  "N": 222,
  "env_orig_fim": 2288.119,
  "crop": null,
  "envN": 222
 },
 {
  "falante": "padre",
  "cena": "padre_close",
