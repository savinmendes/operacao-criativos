  "fator": 1.0084,
  "fala_de": true,
  "texto": "Nein. Sie zahlen einmalig 37 Euro und erhalten Zugang zum heiligen Benediktusgebet und zu allen Materialien dieses Angebots.",
  "id": "L255",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 66716,
  "N": 310,
  "env_orig_fim": 2252.901,
  "crop": null,
  "envN": 310
 },
 {
