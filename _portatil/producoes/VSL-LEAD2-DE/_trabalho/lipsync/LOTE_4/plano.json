  "dur": 9.237,
  "orig_ini": 2137.5,
  "orig_fim": 2146.267,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "sich jetzt Ihren Zugang und lassen Sie hier etwas Neues beginnen. Gott begleite Ihre Entscheidung – im Namen des Vaters und des Sohnes und des Heiligen Geistes.",
  "id": "L244",
  "lote": 4,
  "corte_dentro_de_palavra": [],
