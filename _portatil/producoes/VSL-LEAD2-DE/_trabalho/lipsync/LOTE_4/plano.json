  "dur": 5.01,
  "orig_ini": 2299.779,
  "orig_fim": 2304.748,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "und die Erstattung gemäß den auf der Seite genannten Bedingungen beantragen.",
  "id": "L262",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 68444,
  "N": 150,
  "env_orig_fim": 2304.748,
  "crop": null,
  "envN": 150
 },
 {
  "falante": "padre",
  "cena": "padre_close",
  "novo_ini": 2286.467,
  "novo_fim": 2297.346,
  "dur": 10.879,
  "orig_ini": 2304.748,
  "orig_fim": 2315.536,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "So müssen Sie Ihre Entscheidung nicht aus Angst treffen. Sie haben genug Zeit, alles kennenzulernen, was für Sie vorbereitet wurde. „Wie kann ich bezahlen?“ Ganz einfach.",
  "id": "L263",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 68594,
  "N": 326,
  "env_orig_fim": 2315.536,
  "crop": null,
  "envN": 326
 },
 {
  "falante": "padre",
  "cena": "padre_close",
  "novo_ini": 2297.346,
  "novo_fim": 2302.842,
  "dur": 5.496,
  "orig_ini": 2315.536,
  "orig_fim": 2320.986,
  "fator": 1.0084,
  "fala_de": true,
  "texto": "Wenn Sie auf den Button unter diesem Video klicken, gelangen Sie auf eine sichere Bezahlseite.",
