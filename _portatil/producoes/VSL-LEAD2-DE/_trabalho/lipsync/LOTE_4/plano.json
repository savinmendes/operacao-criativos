  "cena": "padre_medio",
  "novo_ini": 2070.043,
  "novo_fim": 2076.576,
  "dur": 6.533,
  "orig_ini": 2092.666,
  "orig_fim": 2098.866,
  "fator": 1.0536,
  "fala_de": true,
  "texto": "Sie haben 90 Tage – volle 90 Tage –, um diesen Weg in Ihrem Tempo zu gehen,",
  "id": "L238",
  "lote": 4,
  "corte_dentro_de_palavra": [],
  "q0": 62101,
  "N": 196,
  "env_orig_fim": 2098.866,
  "crop": null,
  "envN": 196
 },
 {
