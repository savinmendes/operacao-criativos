[{"i": 1, "a": 0.0, "b": 5.4, "quem": "m", "texto": "¿Vieron lo que le pasó a esta chica que hizo la oración del Breviario de San Benito?", "es_ini": 0.0, "es_fim": 4.69, "pal": [["¿Vieron", 0.0, 0.43], ["lo", 0.464, 0.557], ["que", 0.615, 0.697], ["le", 0.743, 0.824], ["pasó", 0.882, 1.219], ["a", 1.265, 1.289], ["esta", 1.335, 1.521], ["chica", 1.579, 1.869], ["que", 1.927, 2.043], ["hizo", 2.067, 2.276], ["la", 2.334, 2.403], ["oración", 2.461, 2.937], ["del", 2.995, 3.123], ["Breviario", 3.204, 3.785], ["de", 3.82, 3.889], ["San", 3.936, 4.098], ["Benito?", 4.168, 4.69]]}, {"i": 2, "a": 5.6, "b": 9.8, "quem": "m", "texto": "No hagas la oración del Breviario de San Benito si no quieres cambiar de vida,", "es_ini": 5.69, "es_fim": 10.079, "pal": [["No", 5.69, 5.888], ["hagas", 5.922, 6.166], ["la", 6.213, 6.282], ["oración", 6.329, 6.712], ["del", 6.758, 6.863], ["Breviario", 6.921, 7.385], ["de", 7.408, 7.478], ["San", 7.525, 7.675], ["Benito", 7.745, 8.233], ["si", 8.407, 8.593], ["no", 8.674, 8.778], ["quieres", 8.86, 9.138], ["cambiar", 9.162, 9.51], ["de", 9.579, 9.661], ["vida,", 9.719, 10.079]]}, {"i": 3, "a": 9.9, "b": 13.9, "quem": "m", "texto": "porque esta oración es muy fuerte y maravillosa.", "es_ini": 11.079, "es_fim": 13.564, "pal": [["porque", 11.079, 11.381], ["esta", 11.404, 11.543], ["oración", 11.59, 11.973], ["es", 12.031, 12.078], ["muy", 12.101, 12.31], ["fuerte", 12.368, 12.704], ["y", 12.728, 12.751], ["maravillosa.", 12.797, 13.564]]}, {"i": 4, "a": 14.0, "b": 16.0, "quem": "m", "texto": "Estaba cansada de rezar, ¿sabes?", "es_ini": 14.564, "es_fim": 17.036, "pal": [["Estaba", 14.564, 14.97], ["cansada", 15.016, 15.562], ["de", 15.608, 15.69], ["rezar,", 15.783, 16.235], ["¿sabes?", 16.235, 17.036]]}, {"i": 5, "a": 16.3, "b": 18.4, "quem": "m", "texto": "De vivir en la escasez sin poder comprar nada.", "es_ini": 18.036, "es_fim": 21.066, "pal": [["De", 18.036, 18.175], ["vivir", 18.233, 18.546], ["en", 18.593, 18.651], ["la", 18.709, 18.767], ["escasez", 18.79, 19.394], ["sin", 19.568, 19.8], ["poder", 19.847, 20.16], ["comprar", 20.23, 20.625], ["nada.", 20.706, 21.066]]}, {"i": 6, "a": 18.7, "b": 23.7, "quem": "m", "texto": "Un día estaba viendo la televisión y vi un reportaje sobre el Breviario de San Benito.", "es_ini": 22.551, "es_fim": 28.309, "pal": [["Un", 22.551, 22.713], ["día", 22.771, 22.969], ["estaba", 22.992, 23.317], ["viendo", 23.364, 23.735], ["la", 23.782, 23.84], ["televisión", 23.886, 24.583], ["y", 24.699, 24.815], ["vi", 24.896, 25.012], ["un", 25.128, 25.198], ["reportaje", 25.279, 25.895], ["sobre", 25.964, 26.336], ["el", 26.405, 26.533], ["Breviario", 26.603, 27.299], ["de", 27.381, 27.497], ["San", 27.555, 27.717], ["Benito.", 27.775, 28.309]]}, {"i": 7, "a": 23.8, "b": 26.9, "quem": "m", "texto": "Ya había visto a una chica en TikTok diciendo que también lo hizo.", "es_ini": 29.309, "es_fim": 33.709, "pal": [["Ya", 29.309, 29.46], ["había", 29.483, 29.738], ["visto", 29.796, 30.121], ["a", 30.191, 30.214], ["una", 30.284, 30.446], ["chica", 30.504, 30.841], ["en", 30.888, 30.957], ["TikTok", 31.027, 31.538], ["diciendo", 31.654, 32.385], ["que", 32.501, 32.606], ["también", 32.652, 33.117], ["lo", 33.186, 33.302], ["hizo.", 33.326, 33.709]]}, {"i": 8, "a": 27.4, "b": 31.0, "quem": "m", "texto": "Pero bueno, pensé: lo voy a hacer yo también, no pierdo nada.", "es_ini": 34.709, "es_fim": 38.424, "pal": [["Pero", 34.709, 34.941], ["bueno,", 34.976, 35.312], ["pensé:", 35.382, 35.928], ["lo", 36.067, 36.171], ["voy", 36.218, 36.369], ["a", 36.404, 36.427], ["hacer", 36.45, 36.705], ["yo", 36.764, 36.833], ["también,", 36.88, 37.321], ["no", 37.518, 37.646], ["pierdo", 37.716, 38.052], ["nada.", 38.11, 38.424]]}, {"i": 9, "a": 31.4, "b": 36.3, "quem": "m", "texto": "Fui, compré el Breviario y en ese mismo momento ya estaba todo en mi correo.", "es_ini": 39.424, "es_fim": 44.056, "pal": [["Fui,", 39.424, 39.784], ["compré", 39.888, 40.225], ["el", 40.248, 40.306], ["Breviario", 40.364, 41.026], ["y", 41.095, 41.13], ["en", 41.188, 41.235], ["ese", 41.293, 41.432], ["mismo", 41.479, 41.734], ["momento", 41.792, 42.314], ["ya", 42.407, 42.523], ["estaba", 42.547, 42.883], ["todo", 42.965, 43.278], ["en", 43.336, 43.383], ["mi", 43.429, 43.522], ["correo.", 43.58, 44.056]]}, {"i": 10, "a": 36.6, "b": 43.3, "quem": "m", "texto": "Lo leí todo con calma: las oraciones, la novena y el significado de cada símbolo de la medalla.", "es_ini": 45.5, "es_fim": 51.921, "pal": [["Lo", 45.5, 45.628], ["leí", 45.686, 45.826], ["todo", 45.872, 46.069], ["con", 46.127, 46.267], ["calma:", 46.336, 46.778], ["las", 47.01, 47.138], ["oraciones,", 47.207, 47.997], ["la", 48.078, 48.171], ["novena", 48.217, 48.833], ["y", 49.216, 49.309], ["el", 49.367, 49.425], ["significado", 49.483, 50.179], ["de", 50.249, 50.319], ["cada", 50.377, 50.632], ["símbolo", 50.69, 51.155], ["de", 51.213, 51.271], ["la", 51.317, 51.375], ["medalla.", 51.433, 51.921]]}, {"i": 11, "a": 43.7, "b": 45.2, "quem": "m", "texto": "Después de rezar, me fui a dormir.", "es_ini": 52.921, "es_fim": 54.929, "pal": [["Después", 52.921, 53.292], ["de", 53.327, 53.385], ["rezar,", 53.455, 53.907], ["me", 54.047, 54.14], ["fui", 54.209, 54.349], ["a", 54.383, 54.407], ["dormir.", 54.453, 54.929]]}, {"i": 12, "a": 45.6, "b": 50.7, "quem": "m", "texto": "Ese día ya estaba medio triste, porque me habían despedido y tenía el alquiler atrasado,", "es_ini": 55.929, "es_fim": 61.095, "pal": [["Ese", 55.929, 56.254], ["día", 56.301, 56.521], ["ya", 56.591, 56.672], ["estaba", 56.696, 57.032], ["medio", 57.079, 57.323], ["triste,", 57.381, 57.845], ["porque", 57.915, 58.182], ["me", 58.24, 58.309], ["habían", 58.333, 58.599], ["despedido", 58.657, 59.284], ["y", 59.354, 59.4], ["tenía", 59.482, 59.83], ["el", 59.865, 59.946], ["alquiler", 60.004, 60.399], ["atrasado,", 60.457, 61.095]]}, {"i": 13, "a": 51.0, "b": 55.0, "quem": "m", "texto": "pero bueno, al día siguiente, ¡Dios mío!", "es_ini": 62.095, "es_fim": 64.312, "pal": [["pero", 62.095, 62.327], ["bueno,", 62.362, 62.64], ["al", 62.71, 62.838], ["día", 62.896, 63.023], ["siguiente,", 63.081, 63.546], ["¡Dios", 63.546, 63.882], ["mío!", 63.975, 64.312]]}, {"i": 14, "a": 55.0, "b": 61.3, "quem": "m", "texto": "Me desperté con una oferta de trabajo donde ganaría cuatro veces más que en el anterior.", "es_ini": 65.466, "es_fim": 70.563, "pal": [["Me", 65.466, 65.641], ["desperté", 65.687, 66.186], ["con", 66.244, 66.384], ["una", 66.407, 66.5], ["oferta", 66.523, 66.964], ["de", 66.987, 67.034], ["trabajo", 67.069, 67.591], ["donde", 67.626, 67.87], ["ganaría", 67.916, 68.346], ["cuatro", 68.462, 68.903], ["veces", 68.961, 69.333], ["más", 69.426, 69.693], ["que", 69.739, 69.809], ["en", 69.832, 69.878], ["el", 69.925, 69.994], ["anterior.", 70.041, 70.563]]}, {"i": 15, "a": 61.7, "b": 63.9, "quem": "m", "texto": "Y ni siquiera me había postulado a ese puesto.", "es_ini": 71.563, "es_fim": 74.187, "pal": [["Y", 71.563, 71.644], ["ni", 71.76, 71.853], ["siquiera", 71.9, 72.341], ["me", 72.399, 72.469], ["había", 72.492, 72.701], ["postulado", 72.759, 73.328], ["a", 73.363, 73.386], ["ese", 73.432, 73.606], ["puesto.", 73.653, 74.187]]}, {"i": 16, "a": 64.5, "b": 70.0, "quem": "m", "texto": "Un amigo le habló de mí al director de esa empresa, y ni siquiera fue una recomendación oficial.", "es_ini": 75.187, "es_fim": 80.47, "pal": [["Un", 75.187, 75.361], ["amigo", 75.419, 75.721], ["le", 75.768, 75.814], ["habló", 75.837, 76.046], ["de", 76.081, 76.151], ["mí", 76.197, 76.325], ["al", 76.371, 76.418], ["director", 76.476, 76.917], ["de", 76.975, 77.045], ["esa", 77.08, 77.196], ["empresa,", 77.219, 77.777], ["y", 77.986, 78.055], ["ni", 78.125, 78.206], ["siquiera", 78.264, 78.694], ["fue", 78.764, 78.926], ["una", 78.984, 79.135], ["recomendación", 79.182, 79.878], ["oficial.", 79.936, 80.47]]}, {"i": 17, "a": 70.6, "b": 72.9, "quem": "m", "texto": "Pero pensé: coincidencia, ¿no?", "es_ini": 81.47, "es_fim": 83.792, "pal": [["Pero", 81.47, 81.772], ["pensé:", 81.819, 82.295], ["coincidencia,", 82.597, 83.456], ["¿no?", 83.456, 83.792]]}, {"i": 18, "a": 73.2, "b": 74.0, "quem": "m", "texto": "Me tomé mi café.", "es_ini": 84.792, "es_fim": 85.895, "pal": [["Me", 84.792, 84.92], ["tomé", 84.966, 85.187], ["mi", 85.233, 85.315], ["café.", 85.373, 85.895]]}, {"i": 19, "a": 74.6, "b": 83.0, "quem": "m", "texto": "Cuando agarré el celular otra vez, tenía una transferencia de 8 mil dólares de mi abogado, de un juicio que ya dábamos por perdido.", "es_ini": 87.327, "es_fim": 94.606, "pal": [["Cuando", 87.327, 87.582], ["agarré", 87.629, 87.93], ["el", 87.954, 88.012], ["celular", 88.058, 88.441], ["otra", 88.488, 88.697], ["vez,", 88.743, 89.01], ["tenía", 89.103, 89.335], ["una", 89.382, 89.498], ["transferencia", 89.544, 90.31], ["de", 90.357, 90.427], ["8", 90.508, 90.752], ["mil", 90.798, 90.961], ["dólares", 91.03, 91.425], ["de", 91.448, 91.495], ["mi", 91.553, 91.622], ["abogado,", 91.657, 92.214], ["de", 92.493, 92.574], ["un", 92.632, 92.69], ["juicio", 92.725, 93.108], ["que", 93.155, 93.236], ["ya", 93.317, 93.422], ["dábamos", 93.468, 93.863], ["por", 93.921, 94.049], ["perdido.", 94.119, 94.606]]}, {"i": 20, "a": 83.7, "b": 86.8, "quem": "m", "texto": "Y pensé: sigue siendo coincidencia, ¿no puede ser?", "es_ini": 95.606, "es_fim": 98.752, "pal": [["Y", 95.606, 95.699], ["pensé:", 95.815, 96.268], ["sigue", 96.593, 96.872], ["siendo", 96.918, 97.185], ["coincidencia,", 97.231, 97.986], ["¿no", 97.986, 98.172], ["puede", 98.218, 98.427], ["ser?", 98.473, 98.752]]}, {"i": 21, "a": 87.7, "b": 91.6, "quem": "m", "texto": "Después fui a visitar a mi abuela, que llevaba años intentando jubilarse.", "es_ini": 99.752, "es_fim": 104.047, "pal": [["Después", 99.752, 100.193], ["fui", 100.251, 100.355], ["a", 100.39, 100.413], ["visitar", 100.448, 100.82], ["a", 100.855, 100.878], ["mi", 100.913, 100.982], ["abuela,", 101.017, 101.435], ["que", 101.621, 101.714], ["llevaba", 101.737, 102.167], ["años", 102.283, 102.735], ["intentando", 102.852, 103.374], ["jubilarse.", 103.409, 104.047]]}, {"i": 22, "a": 92.0, "b": 96.6, "quem": "m", "texto": "Y tres días después me llamó para decirme que lo había conseguido.", "es_ini": 105.231, "es_fim": 108.807, "pal": [["Y", 105.231, 105.324], ["tres", 105.44, 105.672], ["días", 105.73, 105.927], ["después", 105.986, 106.357], ["me", 106.415, 106.508], ["llamó", 106.531, 106.752], ["para", 106.798, 106.949], ["decirme", 106.996, 107.39], ["que", 107.437, 107.53], ["lo", 107.576, 107.646], ["había", 107.669, 107.948], ["conseguido.", 108.017, 108.807]]}, {"i": 23, "a": 96.8, "b": 100.0, "quem": "m", "texto": "Después de que le expliqué cómo ella también podía hacer esta oración.", "es_ini": 109.807, "es_fim": 113.824, "pal": [["Después", 109.807, 110.213], ["de", 110.259, 110.318], ["que", 110.376, 110.445], ["le", 110.48, 110.538], ["expliqué", 110.561, 111.061], ["cómo", 111.212, 111.606], ["ella", 111.722, 111.885], ["también", 111.943, 112.28], ["podía", 112.338, 112.674], ["hacer", 112.698, 112.976], ["esta", 113.034, 113.22], ["oración.", 113.255, 113.824]]}, {"i": 24, "a": 100.8, "b": 107.1, "quem": "m", "texto": "Ahí dejé de dudar y pensé: ahora solo me queda agradecer, si no, sería muy ingrata.", "es_ini": 114.824, "es_fim": 121.744, "pal": [["Ahí", 114.824, 115.126], ["dejé", 115.196, 115.475], ["de", 115.544, 115.625], ["dudar", 115.683, 116.067], ["y", 116.183, 116.299], ["pensé:", 116.392, 116.984], ["ahora", 117.738, 118.075], ["solo", 118.145, 118.423], ["me", 118.47, 118.563], ["queda", 118.633, 118.9], ["agradecer,", 118.946, 119.643], ["si", 119.863, 120.014], ["no,", 120.084, 120.305], ["sería", 120.386, 120.781], ["muy", 120.873, 121.164], ["ingrata.", 121.233, 121.744]]}, {"i": 25, "a": 107.3, "b": 112.5, "quem": "m", "texto": "Así que les digo, gente: hagan la oración, háganla de la forma correcta y agradezcan.", "es_ini": 122.744, "es_fim": 127.875, "pal": [["Así", 122.744, 123.011], ["que", 123.057, 123.138], ["les", 123.196, 123.347], ["digo,", 123.382, 123.649], ["gente:", 123.73, 124.172], ["hagan", 124.241, 124.543], ["la", 124.601, 124.648], ["oración,", 124.671, 125.216], ["háganla", 125.321, 125.75], ["de", 125.809, 125.878], ["la", 125.925, 126.006], ["forma", 126.087, 126.412], ["correcta", 126.459, 126.97], ["y", 127.051, 127.109], ["agradezcan.", 127.19, 127.875]]}, {"i": 26, "a": 112.5, "b": 116.1, "quem": "m", "texto": "Porque la fuerza de San Benito es muy, muy fuerte.", "es_ini": 129.423, "es_fim": 132.117, "pal": [["Porque", 129.423, 129.679], ["la", 129.725, 129.783], ["fuerza", 129.83, 130.12], ["de", 130.155, 130.213], ["San", 130.259, 130.399], ["Benito", 130.434, 130.805], ["es", 130.84, 130.91], ["muy,", 131.026, 131.351], ["muy", 131.409, 131.606], ["fuerte.", 131.664, 132.117]]}, {"i": 27, "a": 116.5, "b": 121.1, "quem": "p", "texto": "Voy a dejar el Breviario de Protección de San Benito en el botón de abajo, con las instrucciones completas de cómo hacerla.", "es_ini": 0.0, "es_fim": 6.711, "pal": [["Voy", 0.0, 0.174], ["a", 0.209, 0.232], ["dejar", 0.279, 0.534], ["el", 0.569, 0.627], ["Breviario", 0.685, 1.126], ["de", 1.149, 1.207], ["Protección", 1.242, 1.741], ["de", 1.776, 1.834], ["San", 1.881, 2.02], ["Benito", 2.078, 2.601], ["en", 2.728, 2.833], ["el", 2.891, 2.949], ["botón", 3.007, 3.355], ["de", 3.425, 3.483], ["abajo,", 3.518, 3.994], ["con", 4.133, 4.272], ["las", 4.296, 4.4], ["instrucciones", 4.47, 5.074], ["completas", 5.132, 5.689], ["de", 5.735, 5.805], ["cómo", 5.875, 6.107], ["hacerla.", 6.142, 6.711]]}, {"i": 28, "a": 121.6, "b": 125.7, "quem": "p", "texto": "Pero recuerda, esta oración tiene una forma correcta de hacerse.", "es_ini": 7.711, "es_fim": 11.565, "pal": [["Pero", 7.711, 7.92], ["recuerda,", 7.99, 8.558], ["esta", 8.663, 8.93], ["oración", 8.988, 9.441], ["tiene", 9.522, 9.708], ["una", 9.743, 9.882], ["forma", 9.963, 10.288], ["correcta", 10.346, 10.788], ["de", 10.846, 10.904], ["hacerse.", 10.938, 11.565]]}, {"i": 29, "a": 126.3, "b": 134.8, "quem": "p", "texto": "Como enseña el Breviario de San Benito: las oraciones, la novena y el significado de la medalla. Y de regalo, el collar de plata con la medalla de San Benito.", "es_ini": 12.565, "es_fim": 22.317, "pal": [["Como", 12.565, 12.785], ["enseña", 12.82, 13.169], ["el", 13.192, 13.238], ["Breviario", 13.296, 13.737], ["de", 13.772, 13.83], ["San", 13.877, 14.004], ["Benito:", 14.062, 14.608], ["las", 14.863, 15.014], ["oraciones,", 15.084, 15.746], ["la", 15.85, 15.932], ["novena", 15.978, 16.442], ["y", 16.593, 16.675], ["el", 16.744, 16.802], ["significado", 16.86, 17.545], ["de", 17.603, 17.661], ["la", 17.708, 17.754], ["medalla.", 17.801, 18.312], ["Y", 18.718, 18.788], ["de", 18.869, 18.927], ["regalo,", 18.985, 19.496], ["el", 19.693, 19.809], ["collar", 19.879, 20.169], ["de", 20.239, 20.297], ["plata", 20.355, 20.715], ["con", 20.761, 20.889], ["la", 20.924, 20.97], ["medalla", 21.017, 21.4], ["de", 21.458, 21.516], ["San", 21.574, 21.737], ["Benito.", 21.783, 22.317]]}, {"i": 30, "a": 135.4, "b": 136.4, "quem": "p", "texto": "Accede mientras hay tiempo.", "es_ini": 23.642, "es_fim": 25.268, "pal": [["Accede", 23.642, 24.13], ["mientras", 24.176, 24.571], ["hay", 24.629, 24.734], ["tiempo.", 24.78, 25.268]]}, {"i": 31, "a": 137.4, "b": 138.8, "quem": "p", "texto": "Tu hora de vencer llegó.", "es_ini": 26.268, "es_fim": 27.696, "pal": [["Tu", 26.268, 26.407], ["hora", 26.465, 26.686], ["de", 26.732, 26.802], ["vencer", 26.86, 27.243], ["llegó.", 27.301, 27.696]]}]