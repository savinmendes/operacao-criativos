  "fala_fim": 75.41,
  "segmentos": [
   {
    "i": 0,
    "texto": "Hola, maestros. Hoy les voy a presentar el kit de taladro percutor y atornillador inalámbrico DeWalt, de veinte volts MAX, con baterías de ion de litio. Vamos a verlo.",
    "inicio": 0.0,
    "fim": 9.61,
    "dur": 9.61,
    "orig_ini": 0.0,
    "orig_fim": 11.0
   },
   {
    "i": 1,
    "texto": "Trae cargador, dos baterías de dos amperes hora y una maleta para guardar y llevar todo.",
    "inicio": 11.0,
    "fim": 16.39,
    "dur": 5.39,
    "orig_ini": 11.0,
    "orig_fim": 16.5
   },
   {
    "i": 2,
    "texto": "Tiene mandril de ajuste rápido de media pulgada, trece milímetros.",
    "inicio": 16.51,
    "fim": 20.64,
    "dur": 4.13,
    "orig_ini": 16.5,
    "orig_fim": 20.5
   },
   {
    "i": 3,
    "texto": "Así cambias brocas y puntas en segundos, sin necesidad de usar llave.",
    "inicio": 20.76,
    "fim": 24.94,
    "dur": 4.18,
    "orig_ini": 20.5,
    "orig_fim": 24.5
   },
   {
    "i": 4,
    "texto": "Es compacto y bien liviano en la mano.",
    "inicio": 25.06,
    "fim": 26.96,
    "dur": 1.9,
    "orig_ini": 24.5,
    "orig_fim": 26.5
   },
   {
    "i": 5,
    "texto": "Viene con motor sin carbones, brushless.",
    "inicio": 27.08,
    "fim": 29.59,
    "dur": 2.51,
    "orig_ini": 26.5,
    "orig_fim": 29.5
   },
   {
    "i": 6,
    "texto": "Tiene dos velocidades mecánicas, con gatillo variable y reversa.",
    "inicio": 29.71,
    "fim": 33.8,
    "dur": 4.09,
    "orig_ini": 29.5,
    "orig_fim": 33.5
   },
   {
    "i": 7,
    "texto": "En la segunda velocidad llega hasta mil setecientas cincuenta revoluciones por minuto, para perforar rápido.",
    "inicio": 33.92,
    "fim": 40.24,
    "dur": 6.32,
    "orig_ini": 33.5,
    "orig_fim": 40.5
   },
   {
    "i": 8,
    "texto": "Su anillo tiene quince posiciones de torque, para apretar justo cada tornillo sin dañar el material.",
    "inicio": 40.5,
    "fim": 45.7,
    "dur": 5.2,
    "orig_ini": 40.5,
    "orig_fim": 47.0
   },
   {
    "i": 9,
    "texto": "Y cada batería tiene su indicador de carga incorporado.",
    "inicio": 47.0,
    "fim": 50.06,
    "dur": 3.06,
    "orig_ini": 47.0,
    "orig_fim": 50.5
   },
   {
    "i": 10,
    "texto": "Con él puedes perforar sin ningún problema en distintos tipos de madera,",
    "inicio": 51.5,
    "fim": 55.54,
    "dur": 4.04,
    "orig_ini": 51.5,
    "orig_fim": 55.5
   },
   {
    "i": 11,
    "texto": "y también en metal, para fierros y estructuras,",
    "inicio": 55.66,
    "fim": 58.72,
    "dur": 3.06,
    "orig_ini": 55.5,
    "orig_fim": 58.5
   },
   {
    "i": 12,
    "texto": "y en muro o concreto, usando el modo percutor.",
    "inicio": 58.84,
    "fim": 61.82,
    "dur": 2.97,
    "orig_ini": 58.5,
    "orig_fim": 61.5
   },
   {
    "i": 13,
    "texto": "Tiene luz LED para trabajar en lugares oscuros.",
    "inicio": 61.94,
    "fim": 64.72,
    "dur": 2.79,
    "orig_ini": 61.5,
    "orig_fim": 64.5
   },
   {
    "i": 14,
    "texto": "Ideal para atornillar, armar muebles, estructuras metálicas y para la mantención de la casa o de la obra.",
    "inicio": 64.84,
    "fim": 71.02,
    "dur": 6.18,
    "orig_ini": 64.5,
    "orig_fim": 71.5
   },
   {
    "i": 15,
    "texto": "Pre Black Friday: Pídelo hoy y pagas recién cuando te llegue.",
    "inicio": 71.6,
    "fim": 75.41,
    "dur": 3.81,
    "orig_ini": null,
    "orig_fim": null
   }
  ]
 },
